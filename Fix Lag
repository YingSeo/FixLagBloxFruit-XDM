local paintedBoats = {}

local function paintBoat(model)
    if paintedBoats[model] then return end
    paintedBoats[model] = true
    task.spawn(function()
        for _,o in ipairs(model:GetDescendants()) do
            if o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation") then
                safeSet(o,"Color",BLACK); safeSet(o,"Material",Enum.Material.SmoothPlastic)
            elseif o:IsA("Decal") or o:IsA("Texture") then
                safeSet(o,"Color3",BLACK); safeSet(o,"Transparency",1)
            end
        end
        model.DescendantAdded:Connect(function(o)
            task.defer(function()
                if not (o and o.Parent) then return end
                if o:IsA("BasePart") or o:IsA("MeshPart") then
                    safeSet(o,"Color",BLACK); safeSet(o,"Material",Enum.Material.SmoothPlastic)
                elseif o:IsA("Decal") or o:IsA("Texture") then
                    safeSet(o,"Color3",BLACK); safeSet(o,"Transparency",1)
                end
            end)
        end)
    end)
end

task.spawn(function()
    for _,o in ipairs(WS:GetDescendants()) do if isBoat(o) then paintBoat(o) end end
end)
WS.DescendantAdded:Connect(function(o)
    task.defer(function() if o and o.Parent and isBoat(o) then paintBoat(o) end end)
end)

local OVL_W = {
    "v4","race","border","vignette","edge","rim","glow","aura",
    "overlay","screenfx","effect","terroshark","terror","shark",
    "seabeast","beast","darkscreen","blackscreen","darken","fog",
    "mist","flash","warning","alert","danger","encounter",
    "boss","spawn","appear","cinematic","cutscene",
}

local function isOverlay(o)
    if not (o:IsA("Frame") or o:IsA("ImageLabel")
         or o:IsA("ScreenGui") or o:IsA("ImageButton")) then return false end
    if hasWord(o.Name, OVL_W) then return true end
    if o:IsA("Frame") or o:IsA("ImageLabel") then
        local ok,bc = pcall(function() return o.BackgroundColor3 end)
        if ok and (bc.R+bc.G+bc.B)<0.15 then
            local ok2,tr = pcall(function() return o.BackgroundTransparency end)
            if ok2 and tr<0.85 then return true end
        end
        local ok3,sz = pcall(function() return o.Size end)
        if ok3 and sz.X.Scale>=0.8 and sz.Y.Scale>=0.8 then
            local ok4,tr2 = pcall(function() return o.BackgroundTransparency end)
            if ok4 and tr2<0.95 then return true end
        end
    end
    return false
end

local function stripOverlay(gui)
    if not gui then return end
    for _,o in ipairs(gui:GetDescendants()) do
        if isOverlay(o) then
            safeSet(o,"Visible",false)
            safeSet(o,"BackgroundTransparency",1)
            safeSet(o,"ImageTransparency",1)
        end
    end
end

