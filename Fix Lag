local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local map = Workspace:FindFirstChild("Map")

if not map then
    warn("Không tìm thấy Workspace.Map")
    return
end

local queue = {}
local head = 1
local running = true

local BATCH_SIZE = 25
local DELAY = 0.02

local protected = {}

local function lower(v)
    return string.lower(v or "")
end

local function isProtectedModel(model)
    if not model or not model:IsA("Model") then
        return false
    end

    local name = lower(model.Name)

    if name:find("boat", 1, true)
        or name:find("ship", 1, true)
        or name:find("raft", 1, true)
        or name:find("boat", 1, true) then
        return true
    end

    if name == "enemies"
        or name == "enemy"
        or name == "npcs"
        or name == "npc"
        or name == "characters"
        or name == "characters" then
        return true
    end

    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if model:FindFirstChildWhichIsA("VehicleSeat", true) then
        return true
    end

    return false
end

local function isPlayerCharacter(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        local character = p.Character
        if character and obj:IsDescendantOf(character) then
            return true
        end
    end

    return false
end

local function hideObject(obj)
    if not obj or not obj.Parent then
        return
    end

    if obj:IsA("BasePart") then
        obj.LocalTransparencyModifier = 1
        obj.CastShadow = false
        return
    end

    if obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1
        return
    end

    if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then
        obj.Enabled = false
        return
    end

    if obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
        obj.Enabled = false
    end
end

local function addNode(obj, parentProtected)
    if not obj or not obj.Parent then
        return
    end

    local currentProtected = parentProtected

    if not currentProtected and obj:IsA("Model") then
        currentProtected = isProtectedModel(obj)
    end

    if isPlayerCharacter(obj) then
        currentProtected = true
    end

    queue[#queue + 1] = {
        object = obj,
        protected = currentProtected
    }
end

for _, obj in ipairs(map:GetChildren()) do
    addNode(obj, false)
end

map.ChildAdded:Connect(function(obj)
    if running then
        addNode(obj, false)
    end
end)

task.spawn(function()
    while running and head <= #queue do
        local processed = 0

        while processed < BATCH_SIZE and head <= #queue do
            local item = queue[head]
            head += 1
            processed += 1

            local obj = item.object

            if obj and obj.Parent then
                if not item.protected then
                    hideObject(obj)
                end

                if obj:IsA("Folder") or obj:IsA("Model") then
                    for _, child in ipairs(obj:GetChildren()) do
                        addNode(child, item.protected)
                    end
                end
            end
        end

        task.wait(DELAY)
    end

    running = false
end)

print("Map optimizer started")
