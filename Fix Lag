    bar.Size             = UDim2.new(0, 4, 0, 22)
    bar.Position         = UDim2.new(0, 7, 0.5, -11)
    bar.BackgroundColor3 = Color3.fromRGB(0, 200, 120)
    bar.BorderSizePixel  = 0
