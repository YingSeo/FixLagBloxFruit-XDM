local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

repeat task.wait() until game:IsLoaded()

local runtime = Workspace:FindFirstChild("MrDonRuntime")

if runtime then
    runtime:Destroy()
end

runtime = Instance.new("Folder")
runtime.Name = "MrDonRuntime"
runtime.Parent = Workspace

local hidden = {}
local protectedCache = {}

local function lower(name)
    return string.lower(name or "")
end

local function hasBoatName(name)
    name = lower(name)

    return name:find("boat", 1, true)
        or name:find("ship", 1, true)
        or name:find("raft", 1, true)
        or name:find("dinghy", 1, true)
        or name:find("sailboat", 1, true)
end

local function isCharacterModel(obj)
    return obj
        and obj:IsA("Model")
        and obj:FindFirstChildOfClass("Humanoid") ~= nil
end

local function isBoatModel(obj)
    if not obj or not obj:IsA("Model") then
        return false
    end

    if obj:FindFirstChildWhichIsA("VehicleSeat", true) then
        return true
    end

    if hasBoatName(obj.Name) then
        return true
    end

    return false
end

local function isProtectedModel(obj)
    if not obj or not obj:IsA("Model") then
        return false
    end

    if player.Character and obj == player.Character then
        return true
    end

    if isCharacterModel(obj) then
        return true
    end

    if isBoatModel(obj) then
        return true
    end

    local name = lower(obj.Name)

    return name == "npc"
        or name == "npcs"
        or name == "enemy"
        or name == "enemies"
        or name == "characters"
        or name == "boats"
        or name == "ships"
end

local function showObject(obj)
    if not obj or not obj.Parent then
        return
    end

    if obj:IsA("BasePart") then
        obj.LocalTransparencyModifier = 0
        obj.CastShadow = true

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 0

    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then
        obj.Enabled = true

    elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
        obj.Enabled = true

    elseif obj:IsA("Highlight") then
        obj.Enabled = true
    end
end

local function showCharacter(character)
    if not character then
        return
    end

    protectedCache[character] = true

    showObject(character)

    for _, obj in ipairs(character:GetDescendants()) do
        showObject(obj)
        protectedCache[obj] = true
    end
end

local function protectModel(model)
    if not model then
        return
    end

    protectedCache[model] = true

    for _, obj in ipairs(model:GetDescendants()) do
        protectedCache[obj] = true
    end
end

local function isProtected(obj)
    if not obj then
        return true
    end

    if obj == runtime then
        return true
    end

    if protectedCache[obj] then
        return true
    end

    local character = player.Character

    if character and (obj == character or obj:IsDescendantOf(character)) then
        protectedCache[obj] = true
        return true
    end

    local current = obj

    while current and current ~= Workspace do
        if current:IsA("Model") then
            if isCharacterModel(current) or isBoatModel(current) then
                protectModel(current)
                return true
            end
        end

        current = current.Parent
    end

    return false
end

local function hideObject(obj)
    if not obj or not obj.Parent or hidden[obj] then
        return
    end

    if isProtected(obj) then
        showObject(obj)
        return
    end

    hidden[obj] = true

    if obj:IsA("BasePart") then
        obj.LocalTransparencyModifier = 1
        obj.CastShadow = false

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1

    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then
        obj.Enabled = false

    elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
        obj.Enabled = false

    elseif obj:IsA("Highlight") then
        obj.Enabled = false
    end
end

local character = player.Character

if character then
    showCharacter(character)
end

player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter

    task.defer(function()
        showCharacter(newCharacter)
    end)

    newCharacter.DescendantAdded:Connect(function(obj)
        task.defer(function()
            showObject(obj)
            protectedCache[obj] = true
        end)
    end)
end)

local queue = {}
local index = 1

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj ~= runtime and not obj:IsDescendantOf(runtime) then
        queue[#queue + 1] = obj
    end
end

task.spawn(function()
    local batchSize = 700

    while index <= #queue do
        local finish = math.min(index + batchSize - 1, #queue)

        for i = index, finish do
            local obj = queue[i]

            if obj and obj.Parent and not obj:IsDescendantOf(runtime) then
                if isProtected(obj) then
                    showObject(obj)
                else
                    hideObject(obj)
                end
            end
        end

        index = finish + 1

        if index <= #queue then
            RunService.Heartbeat:Wait()
        end
    end
end)

Workspace.DescendantAdded:Connect(function(obj)
    if not obj or not obj.Parent then
        return
    end

    if obj:IsDescendantOf(runtime) then
        return
    end

    task.defer(function()
        if not obj.Parent then
            return
        end

        if isProtected(obj) then
            showObject(obj)

            if obj:IsA("Model") then
                for _, child in ipairs(obj:GetDescendants()) do
                    showObject(child)
                    protectedCache[child] = true
                end
            end
        else
            hideObject(obj)
        end
    end)
end)

local floor = Instance.new("Part")
floor.Name = "InvisibleWaterFloor"
floor.Size = Vector3.new(8192, 2, 8192)
floor.Anchored = true
floor.CanCollide = true
floor.CanTouch = false
floor.CanQuery = true
floor.Transparency = 1
floor.CastShadow = false
floor.Parent = runtime

local function updateFloor()
    local currentCharacter = player.Character

    if not currentCharacter then
        return
    end

    local root = currentCharacter:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    floor.CFrame = CFrame.new(
        root.Position.X,
        root.Position.Y - 3.5,
        root.Position.Z
    )
end

RunService.Heartbeat:Connect(updateFloor)

