-- ── OVERLAY STRIP ────────────────────────────────────────────
local function isUserMenuGui(o)
    local root = o
    while root.Parent and root.Parent ~= GUI and root.Parent ~= game do
        root = root.Parent
    end
    local n = norm(root.Name)
    return n:sub(1,2)=="__" or n:find("menu",1,true) or n:find("hub",1,true)
        or n:find("ui",1,true) or n:find("gui",1,true)
        or n:find("rayfield",1,true) or n:find("orion",1,true)
        or n:find("fluent",1,true) or n:find("kavo",1,true)
        or n:find("redz",1,true)
end
local function isOverlay(o)
    if isUserMenuGui(o) then return false end
    if not(o:IsA("Frame") or o:IsA("ImageLabel")
    or o:IsA("ScreenGui") or o:IsA("ImageButton")) then return false end
    return hasWord(o.Name,OVL_W)
end
local function stripOverlay(gui)
    if not gui then return end
    for _,o in ipairs(gui:GetChildren()) do
        if isOverlay(o) then
            safeSet(o,"Visible",false)
            safeSet(o,"BackgroundTransparency",1)
            safeSet(o,"ImageTransparency",1)
        end
    end
end
if GUI then
    stripOverlay(GUI)
    GUI.DescendantAdded:Connect(function(o)
        task.defer(function()
            if o and o.Parent and isOverlay(o) then
                safeSet(o,"Visible",false)
                safeSet(o,"BackgroundTransparency",1)
                safeSet(o,"ImageTransparency",1)
            end
        end)
    end)
    task.spawn(function()
        while true do task.wait(3) stripOverlay(GUI) end
    end)
end

