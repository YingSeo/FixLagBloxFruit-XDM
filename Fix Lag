-- ── HAKI + HIDE OTHER PLAYERS ────────────────────────────────
local HAKI_W = {"aura","haki","kenbun","observe","kenbunshoku","v2effect","v3effect","v4effect"}

local function isHakiObj(o)
    if (o:IsA("Highlight") or o:IsA("BillboardGui")) and not inProtected(o) then return true end
    return hasWord(o.Name, HAKI_W)
end

local function stripHaki(char)
    if not char then return end
    for _,o in ipairs(char:GetDescendants()) do
        if isHakiObj(o) then safeKill(o) end
    end
    char.DescendantAdded:Connect(function(o)
        task.delay(0, function()
            if o and o.Parent and isHakiObj(o) then safeKill(o) end
        end)
    end)
end

local function hideChar(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.1)
        for _,o in ipairs(char:GetDescendants()) do
            if o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation") then
                safeSet(o,"Transparency",1); safeSet(o,"CastShadow",false)
            elseif o:IsA("Decal") or o:IsA("Texture") then
                safeSet(o,"Transparency",1)
            elseif o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
                safeSet(o,"Enabled",false)
            elseif VFX[o.ClassName] then safeKill(o) end
        end
    end)
end

local function hookPlayer(plr)
    if plr == LP then return end
    local function onChar(char)
        task.wait(0.2); stripHaki(char); hideChar(char)
    end
    if plr.Character then task.spawn(onChar, plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

for _,p in ipairs(Plr:GetPlayers()) do hookPlayer(p) end
Plr.PlayerAdded:Connect(hookPlayer)

-- ── INVISIBLE FLOOR (thay water walk) ────────────────────────
-- Tạo 1 Part tàng hình gắn vào character khi spawn.
-- Part nằm ngay dưới chân, chỉ collide với terrain/sea.
-- Không poll state, không tranh chấp script farm.
-- Tự xoá khi character chết / respawn.

local FLOOR_Y_OFFSET = -3.0   -- khoảng cách từ HumanoidRootPart xuống sàn
local SEA_LEVEL      = 0      -- Y mặt biển mặc định Blox Fruits

local function learnSeaLevel()
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local r = WS:Raycast(Vector3.new(0,500,0), Vector3.new(0,-1000,0), rp)
    if r then SEA_LEVEL = r.Position.Y end
end
task.spawn(learnSeaLevel)

local currentFloor = nil

local function removeFloor()
    if currentFloor and currentFloor.Parent then
        safeKill(currentFloor)
    end
    currentFloor = nil
end

local function spawnFloor(char)
    removeFloor()

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    -- Sàn tàng hình: rộng 120 studs, đủ che toàn bộ vùng bơi
    local floor = Instance.new("Part")
    floor.Name             = "__WaterFloor"
    floor.Size             = Vector3.new(120, 1, 120)
    floor.Transparency     = 1
    floor.CanCollide       = true
    floor.Anchored         = true
    floor.CastShadow       = false
    floor.CanTouch         = false
    floor.CanQuery         = false
    floor.Massless         = true
    floor.Material         = Enum.Material.SmoothPlastic
    floor.CollisionGroup   = "Default"

    -- Đặt ngay tại sea level
    floor.CFrame = CFrame.new(root.Position.X, SEA_LEVEL + FLOOR_Y_OFFSET, root.Position.Z)
    floor.Parent = WS

    currentFloor = floor

    -- Theo nhân vật di chuyển — chỉ cập nhật X/Z, Y cố định tại sea level
    -- Dùng Heartbeat để không ảnh hưởng render, cập nhật mỗi 0.1s tránh overhead
    local lastMove = 0
    local conn
    conn = Run.Heartbeat:Connect(function()
        if not (floor and floor.Parent and root and root.Parent) then
            conn:Disconnect(); return
        end
        local now = tick()
        if now - lastMove < 0.1 then return end
        lastMove = now
        floor.CFrame = CFrame.new(
            root.Position.X,
            SEA_LEVEL + FLOOR_Y_OFFSET,
            root.Position.Z
        )
    end)

    -- Dọn dẹp khi chết
    hum.Died:Connect(function()
        conn:Disconnect()
        removeFloor()
    end)

    -- Dọn dẹp khi character bị remove
    char.AncestryChanged:Connect(function()
        if not char.Parent then
            conn:Disconnect()
            removeFloor()
        end
    end)
end

-- Hook vào character của local player
local function onLocalChar(char)
    -- Đợi character load xong hoàn toàn
    char:WaitForChild("HumanoidRootPart", 10)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.3)
    spawnFloor(char)
end

if LP.Character then task.spawn(onLocalChar, LP.Character) end
LP.CharacterAdded:Connect(onLocalChar)

-- ── CAMERA ANTI-SHAKE ─────────────────────────────────────────
do
    local prevLook = Vector3.new(0,0,-1)
    Run.RenderStepped:Connect(function()
        local cam = WS.CurrentCamera
        if not cam then return end
        purgeCamera()
        local look = cam.CFrame.LookVector
        if look ~= prevLook then
            prevLook = look
            local p = cam.CFrame.Position
            cam.CFrame = CFrame.new(p, p+look)
        end
    end)
end

