local VFX = {
    ParticleEmitter=1, Beam=1, Trail=1,
    Fire=1, Smoke=1, Sparkles=1,
    SelectionBox=1, SelectionSphere=1,
}
local LFX = {
    ColorCorrectionEffect=1, BloomEffect=1, BlurEffect=1,
    SunRaysEffect=1, DepthOfFieldEffect=1, Sky=1, Atmosphere=1,
}
local KEEP = {
    enemies=1, enemy=1, characters=1, character=1,
    npcs=1, npc=1, boats=1, boat=1, ships=1, ship=1,
}
local SPECIAL = { frozendimension=1, prehistoricisland=1, kitsuneisland=1 }

local function norm(s) return s:lower():gsub("[^%w]","") end

local function hasWord(s, words)
    local n = norm(s)
    for i=1,#words do if n:find(words[i],1,true) then return true end end
    return false
end

local function isBoat(o)
    if not o:IsA("Model") then return false end
    local n = norm(o.Name)
    if n:find("boat",1,true) or n:find("ship",1,true)
    or n:find("raft",1,true) or n:find("dinghy",1,true) then return true end
    return o:FindFirstChildWhichIsA("VehicleSeat",true) ~= nil
end

local SEA_W = {"seabeast","terroshark","shark","leviathan","seamonster","seamob","krabbe","krabben"}
local function isSeaMob(o)
    return o:IsA("Model") and hasWord(o.Name, SEA_W)
end

local function isProtected(o)
    if not o:IsA("Model") then return false end
    if o:FindFirstChildOfClass("Humanoid") then return true end
    return isBoat(o) or isSeaMob(o) or SPECIAL[norm(o.Name)] ~= nil
end

local function keepTree(o)
    if o:IsA("Model") then return isProtected(o) end
    return KEEP[norm(o.Name)] == true
end

local function hasProtectedChild(o)
    if keepTree(o) then return true end
    for _,c in ipairs(o:GetChildren()) do
        if keepTree(c) or hasProtectedChild(c) then return true end
    end
    return false
end

local function inProtected(o)
    local p = o.Parent
    while p and p ~= WS and p ~= game do
        if keepTree(p) then return true end
        p = p.Parent
    end
    return false
end

local function safeKill(o) pcall(o.Destroy, o) end
local function safeSet(o,k,v) pcall(function() o[k]=v end) end

for cls in next,LFX do
    local o = Lgt:FindFirstChildOfClass(cls)
