local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local ENABLED = true

-- Số object xử lý mỗi lượt.
-- Tăng = nhanh hơn nhưng dễ giật hơn.
-- Giảm = mượt hơn nhưng lâu hơn.
local BATCH_SIZE = 150

-- Nghỉ giữa các batch để Roblox không bị nghẽn CPU
local BATCH_DELAY = 0.03

--------------------------------------------------
-- CACHE
--------------------------------------------------

local protectedModels = {}
local processed = {}

--------------------------------------------------
-- TÌM MODEL CHA
--------------------------------------------------

local function findProtectedModel(obj)
    local current = obj

    while current and current ~= Workspace do
        if current:IsA("Model") then

            if current:FindFirstChildOfClass("Humanoid") then
                return current
            end

            local name = string.lower(current.Name)

            if string.find(name, "boat", 1, true)
                or string.find(name, "ship", 1, true) then
                return current
            end

            if name == "enemies"
                or name == "enemy"
                or name == "npc"
                or name == "npcs"
                or name == "characters" then
                return current
            end

            -- Thuyền thường có seat
            if current:FindFirstChildWhichIsA("VehicleSeat", true) then
                return current
            end
        end

        current = current.Parent
    end

    return nil
end

--------------------------------------------------
-- KIỂM TRA OBJECT CÓ ĐƯỢC GIỮ KHÔNG
--------------------------------------------------

local function shouldKeep(obj)

    if not obj then
        return true
    end

    -- Character người chơi
    if LocalPlayer.Character
        and obj:IsDescendantOf(LocalPlayer.Character) then
        return true
    end

    -- Camera / Terrain
    if obj.Name == "Camera" or obj == Workspace.Terrain then
        return true
    end

    -- Đã cache model bảo vệ
    for model in pairs(protectedModels) do
        if obj:IsDescendantOf(model) or obj == model then
            return true
        end
    end

    -- Tìm model NPC / Boat / Ship
    local protected = findProtectedModel(obj)

    if protected then
        protectedModels[protected] = true
        return true
    end

    return false
end

--------------------------------------------------
-- ẨN OBJECT NHẸ
--------------------------------------------------

local function optimizeObject(obj)

    if not ENABLED then
        return
    end

    if processed[obj] then
        return
    end

    processed[obj] = true

    -- Không chạm NPC / Player / Boat
    if shouldKeep(obj) then
        return
    end

    ------------------------------------------------
    -- PART
    ------------------------------------------------

    if obj:IsA("BasePart") then
        -- LocalTransparencyModifier chỉ ảnh hưởng client
        obj.LocalTransparencyModifier = 1

        -- Chỉ bỏ shadow, không động physics
        obj.CastShadow = false

    ------------------------------------------------
    -- TEXTURE / DECAL
    ------------------------------------------------

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1

    ------------------------------------------------
    -- PARTICLE / EFFECT
    ------------------------------------------------

    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then

        obj.Enabled = false

    ------------------------------------------------
    -- LIGHT
    ------------------------------------------------

    elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then

        obj.Enabled = false

    ------------------------------------------------
    -- GUI / HIGHLIGHT
    ------------------------------------------------

    elseif obj:IsA("BillboardGui")
        or obj:IsA("SurfaceGui")
        or obj:IsA("Highlight") then

        obj.Enabled = false
    end
end

--------------------------------------------------
-- XỬ LÝ THEO BATCH
--------------------------------------------------

local function optimizeWorkspace()

    local descendants = Workspace:GetDescendants()
    local total = #descendants

    print("Map Optimizer: found", total, "objects")

    local index = 1

    while index <= total and ENABLED do

        local finish = math.min(index + BATCH_SIZE - 1, total)

        for i = index, finish do
            local obj = descendants[i]

            if obj and obj.Parent then
                optimizeObject(obj)
            end
        end

        index = finish + 1

        -- Nhường frame cho Roblox
        task.wait(BATCH_DELAY)
    end

    print("Map Optimizer: finished")
end

--------------------------------------------------
-- OBJECT MỚI SPAWN
--------------------------------------------------

Workspace.DescendantAdded:Connect(function(obj)

    if not ENABLED then
        return
    end

    -- Không xử lý ngay lập tức.
    -- Đợi 1 frame tránh spike CPU khi nhiều object spawn cùng lúc.
    task.defer(function()

        if not obj or not obj.Parent then
            return
        end

        optimizeObject(obj)
    end)
end)

--------------------------------------------------
-- CHẠY
--------------------------------------------------

task.spawn(function()
    optimizeWorkspace()
end)

print("--------------------------------")
print(" Map Optimizer")
print(" NPC    : KEEP")
print(" PLAYER : KEEP")
print(" BOAT   : KEEP")
print(" SHIP   : KEEP")
print(" BATCH  :", BATCH_SIZE)
print("--------------------------------")
