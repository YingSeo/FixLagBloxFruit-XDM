local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local BATCH_SIZE = 500
local queue = {}
local head = 1
local running = true
local protectedModels = {}

local function isBoatName(name)
    name = string.lower(name)
    return name:find("boat", 1, true)
        or name:find("ship", 1, true)
        or name:find("raft", 1, true)
        or name:find("dinghy", 1, true)
        or name:find("sail", 1, true)
end

local function isProtectedModel(obj)
    if not obj:IsA("Model") then
        return false
    end

    if LocalPlayer.Character and obj == LocalPlayer.Character then
        return true
    end

    if obj:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if obj:FindFirstChildWhichIsA("VehicleSeat", true) then
        return true
    end

    if isBoatName(obj.Name) then
        return true
    end

    local name = string.lower(obj.Name)

    return name == "npc"
        or name == "npcs"
        or name == "enemy"
        or name == "enemies"
        or name == "characters"
        or name == "boats"
        or name == "ships"
end

local function hide(obj)
    if not obj or not obj.Parent then
        return
    end

    if obj:IsA("BasePart") then
        obj.LocalTransparencyModifier = 1
        obj.CastShadow = false
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1
    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then
        obj.Enabled = false
    elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
        obj.Enabled = false
    elseif obj:IsA("Highlight") then
        obj.Enabled = false
    elseif obj:IsA("BillboardGui")
        or obj:IsA("SurfaceGui") then
        obj.Enabled = false
    end
end

local function addTree(obj, protected)
    if not obj or not obj.Parent then
        return
    end

    local currentProtected = protected

    if not currentProtected and obj:IsA("Model") then
        currentProtected = isProtectedModel(obj)

        if currentProtected then
            protectedModels[obj] = true
        end
    end

    queue[#queue + 1] = {
        object = obj,
        protected = currentProtected
    }
end

for _, obj in ipairs(Workspace:GetChildren()) do
    addTree(obj, false)
end

Workspace.DescendantAdded:Connect(function(obj)
    if not running then
        return
    end

    task.defer(function()
        if obj and obj.Parent then
            addTree(obj, false)
        end
    end)
end)

task.spawn(function()
    while running and head <= #queue do
        local finish = math.min(head + BATCH_SIZE - 1, #queue)

        for i = head, finish do
            local item = queue[i]
            local obj = item.object

            if obj and obj.Parent then
                if not item.protected then
                    hide(obj)
                end

                if obj:IsA("Folder") or obj:IsA("Model") then
                    local childProtected = item.protected

                    if not childProtected and obj:IsA("Model") then
                        childProtected = protectedModels[obj] == true
                    end

                    for _, child in ipairs(obj:GetChildren()) do
                        addTree(child, childProtected)
                    end
                end
            end
        end

        head = finish + 1

        if head <= #queue then
            RunService.Heartbeat:Wait()
        end
    end

    running = false
end)

print("FULL MAP CLEANER ON")
