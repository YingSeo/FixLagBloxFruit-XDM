    local MID = Color3.fromRGB(255,180,0)
    local LO  = Color3.fromRGB(255,60,60)

    Run.RenderStepped:Connect(function(dt)
        fc += 1; at += dt
        if at >= 0.5 then
            local fps = math.round(fc/at)
            lbl.Text = "FPS: "..fps
            bar.BackgroundColor3 = (fps>=50 and HI) or (fps>=30 and MID) or LO
            fc,at = 0,0
        end
    end)
end)

