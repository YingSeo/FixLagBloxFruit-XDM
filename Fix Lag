-- ── WATER SNAP — bind PreSimulation (chạy trước physics + camera) ──
--[[
    Dùng Stepped (PreSimulation) thay RenderStepped:
    Stepped chạy TRƯỚC khi Roblox tính physics frame,
    nên nhân vật không bao giờ lọt xuống dưới SNAP_LIMIT
    kể cả 1 frame. Camera cũng không thấy lún.
]]
Run.Stepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    local pos   = root.Position
    local state = hum:GetState()
    local underwater = pos.Y < SNAP_LIMIT
                    or state == Enum.HumanoidStateType.Swimming

    if underwater then
        pcall(function()
            local _,ry,_ = root.CFrame:ToEulerAnglesYXZ()
            root.CFrame = CFrame.new(pos.X, SNAP_Y, pos.Z)
                        * CFrame.Angles(0,ry,0)
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                math.max(root.AssemblyLinearVelocity.Y, 0),
                root.AssemblyLinearVelocity.Z
            )
        end)
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
end)

-- ── CAMERA LOCK — chạy RenderStepped để giữ camera không lún ──
--[[
    Sau khi Stepped snap root lên, camera Roblox đôi khi
    vẫn interpolate xuống 1 frame. Lock camera Y >= SNAP_Y
    trong RenderStepped để đảm bảo không thấy lún dù 1ms.
]]
local function purgeCamera()
    local cam = WS.CurrentCamera
    if not cam then return end
    for _,o in ipairs(cam:GetChildren()) do
        if VFX[o.ClassName] or LFX[o.ClassName] then safeKill(o) end
    end
end

do
    local prevLook = Vector3.new(0,0,-1)
    Run.RenderStepped:Connect(function()
        local cam = WS.CurrentCamera
        if not cam then return end

        purgeCamera()

        local cf   = cam.CFrame
        local look = cf.LookVector
        if look ~= prevLook then
            prevLook = look
            local p = cf.Position
            cam.CFrame = CFrame.new(p, p + look)
        end

        -- Lock camera không xuống dưới mặt nước
        local camPos = cam.CFrame.Position
        if camPos.Y < SNAP_Y then
            local locked = Vector3.new(camPos.X, SNAP_Y + 1, camPos.Z)
            cam.CFrame   = CFrame.new(locked, locked + cam.CFrame.LookVector)
        end
    end)
end

