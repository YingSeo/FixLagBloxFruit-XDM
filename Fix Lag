local VFX_CLASSES = {
    ParticleEmitter = true, Beam = true, Trail = true, Fire = true, Smoke = true, Sparkles = true, 
    SelectionBox = true, SelectionSphere = true, Highlight = true, PointLight = true, SpotLight = true, SurfaceLight = true
}
local LFX_CLASSES = {
    ColorCorrectionEffect = true, BloomEffect = true, BlurEffect = true, SunRaysEffect = true, DepthOfFieldEffect = true, Sky = true, Atmosphere = true
}
local SEA_WORDS = {"seabeast", "terroshark", "shark", "leviathan", "seamonster", "seamob", "krabbe", "krabben"}
local HAKI_V4_WORDS = {"aura", "haki", "kenbun", "observe", "kenbunshoku", "v2effect", "v3effect", "v4", "v4effect", "racev4", "awakening", "transform", "wings", "halo", "energy", "vignette"}
local WATER_WORDS = {"water", "ocean", "sea", "wave", "lakewater", "waterzone"}
local OVL_WORDS = {"v4vignette", "racevignette", "screenvignette", "darkscreenvignette", "blackscreenoverlay", "fogoverlay", "mistoverlay", "terrosharkscreen", "seabeastscreen", "cinematicoverlay", "cutsceneoverlay"}
local DMG_WORDS = {"damageindicator", "floatingdamagetext", "combatdamagetext", "hitdamagepopup"}
local MOB_FX_WORDS = {"skill", "attack", "hit", "fx", "effect", "blast", "slash", "explosion", "magic", "spell"}

local function norm(s) return s:lower():gsub("[^%w]", "") end
local function hasWord(s, words)
    local n = norm(s)
    for i = 1, #words do if n:find(words[i], 1, true) then return true end end
    return false
end
local function safeKill(o) pcall(function() o:Destroy() end) end
local function safeSet(o, k, v) pcall(function() o[k] = v end) end

local function isProtected(o)
    if not o or not o.Parent then return true end
    if o:IsA("Model") then
        if o:FindFirstChildOfClass("Humanoid") then return true end
        local n = norm(o.Name)
        if n:find("boat", 1, true) or n:find("ship", 1, true) or n:find("raft", 1, true) or hasWord(n, SEA_WORDS) then return true end
    end
    return false
end

for cls in pairs(LFX_CLASSES) do
    local o = Lgt:FindFirstChildOfClass(cls)
    if o then safeKill(o) end
end
Lgt.GlobalShadows = false
Lgt.FogEnd = 1e5
Lgt.FogStart = 99999
Lgt.Brightness = 2
Lgt.ClockTime = 14
Lgt.Ambient = Color3.fromRGB(178, 178, 178)
Lgt.OutdoorAmbient = Color3.fromRGB(178, 178, 178)

Lgt.ChildAdded:Connect(function(o)
    if LFX_CLASSES[o.ClassName] then
        task.defer(function() if o.Parent then safeKill(o) end end)
    end
end)

local FLOOR_NAME = "__XDM_SeaFloor"

local function buildSeaFloor()
    local existing = WS:FindFirstChild(FLOOR_NAME)
    if existing then safeKill(existing) end

    local p = Instance.new("Part")
    p.Name = FLOOR_NAME
    p.Size = Vector3.new(2000000, 4, 2000000)
    p.CFrame = CFrame.new(0, -2, 0)
    p.Transparency = 1
    p.Anchored = true
    p.CanCollide = true
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.SmoothPlastic
    p.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5, 1, 1)
    p.Parent = WS
end

local function disableWaterVisuals()
    local t = WS:FindFirstChildOfClass("Terrain")
    if not t then return end
    safeSet(t, "Decoration", false)
    safeSet(t, "WaterWaveSize", 0)
    safeSet(t, "WaterWaveSpeed", 0)
    safeSet(t, "WaterReflectance", 0)
    safeSet(t, "WaterTransparency", 1)
    local cl = t:FindFirstChildOfClass("Clouds")
    if cl then safeKill(cl) end
end

local function setupCharacter(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
    end)

    hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Swimming then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

task.spawn(function()
    buildSeaFloor()
    disableWaterVisuals()
    if LP.Character then setupCharacter(LP.Character) end
    LP.CharacterAdded:Connect(setupCharacter)
end)

WS.DescendantAdded:Connect(function(o)
    task.defer(function()
        if o and o.Parent and o:IsA("BasePart") and hasWord(o.Name, WATER_WORDS) and not isProtected(o) then
            safeKill(o)
        end
    end)
end)

local function cleanEffects(obj)
    if not obj or not obj.Parent then return end
    for _, child in ipairs(obj:GetDescendants()) do
        if VFX_CLASSES[child.ClassName] then
            safeKill(child)
        elseif hasWord(child.Name, HAKI_V4_WORDS) or hasWord(child.Name, MOB_FX_WORDS) then
            if child:IsA("BasePart") or child:IsA("Decal") or child:IsA("Texture") then
                safeSet(child, "Transparency", 1)
            else
                safeKill(child)
            end
        end
    end
end

task.spawn(function()
    cleanEffects(WS)
    WS.DescendantAdded:Connect(function(o)
        task.defer(function()
            if not o or not o.Parent then return end
            if VFX_CLASSES[o.ClassName] or hasWord(o.Name, HAKI_V4_WORDS) or hasWord(o.Name, MOB_FX_WORDS) then
                if not isProtected(o.Parent) then
                    if o:IsA("BasePart") or o:IsA("Decal") or o:IsA("Texture") then
                        safeSet(o, "Transparency", 1)
                    else
                        safeKill(o)
                    end
                end
            end
        end)
    end)
end)

local function optimizeSeaEntities(o)
    if not (o and o.Parent and o:IsA("Model")) then return end
    local name = norm(o.Name)
    if name:find("boat", 1, true) or name:find("ship", 1, true) then
        task.spawn(function()
            for _, p in ipairs(o:GetDescendants()) do
                if p:IsA("BasePart") then safeSet(p, "Color", BLACK); safeSet(p, "Material", Enum.Material.SmoothPlastic)
                elseif p:IsA("Decal") or p:IsA("Texture") then safeSet(p, "Transparency", 1) end
            end
        end)
    elseif hasWord(name, SEA_WORDS) then
        task.spawn(function()
            for _, p in ipairs(o:GetDescendants()) do
                if p:IsA("BasePart") then safeSet(p, "Color", UGLY); safeSet(p, "Material", Enum.Material.SmoothPlastic)
                elseif p:IsA("Decal") or p:IsA("Texture") then safeSet(p, "Transparency", 1)
                elseif VFX_CLASSES[p.ClassName] then safeKill(p) end
            end
        end)
    end
end

for _, o in ipairs(WS:GetChildren()) do optimizeSeaEntities(o) end
WS.ChildAdded:Connect(function(o) task.defer(function() optimizeSeaEntities(o) end) end)

local function cleanUI(gui)
    if not gui then return end
    for _, o in ipairs(gui:GetDescendants()) do
        if hasWord(o.Name, OVL_WORDS) or hasWord(o.Name, DMG_WORDS) then
            if o:IsA("GuiObject") or o:IsA("LayerCollector") then
                safeSet(o, "Visible", false)
                safeSet(o, "Enabled", false)
            end
        end
    end
end

if GUI then
    cleanUI(GUI)
    GUI.DescendantAdded:Connect(function(o)
        task.defer(function()
            if hasWord(o.Name, OVL_WORDS) or hasWord(o.Name, DMG_WORDS) then
                if o:IsA("GuiObject") or o:IsA("LayerCollector") then
                    safeSet(o, "Visible", false)
                    safeSet(o, "Enabled", false)
                end
            end
        end)
    end)
end

local function stripCharacterFX(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.2)
        for _, o in ipairs(char:GetDescendants()) do
            if VFX_CLASSES[o.ClassName] or hasWord(o.Name, HAKI_V4_WORDS) then
                safeKill(o)
            elseif (o:IsA("BasePart") or o:IsA("Decal") or o:IsA("Texture")) and hasWord(o.Name, HAKI_V4_WORDS) then
                safeSet(o, "Transparency", 1)
            end
        end
    end)
end

for _, p in ipairs(Plr:GetPlayers()) do
    if p.Character then stripCharacterFX(p.Character) end
    p.CharacterAdded:Connect(stripCharacterFX)
end
Plr.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(stripCharacterFX)
end)

do
    local prevLook = Vector3.new(0, 0, -1)
    Run.RenderStepped:Connect(function()
        local cam = WS.CurrentCamera
        if not cam then return end
        local look = cam.CFrame.LookVector
        if look ~= prevLook then
            prevLook = look
            local p = cam.CFrame.Position
            cam.CFrame = CFrame.new(p, p + look)
        end
    end)
end

task.spawn(function()
    if not GUI then return end
    local old = GUI:FindFirstChild("__XDM_FPS")
    if old then safeKill(old) end

    local sg = Instance.new("ScreenGui")
    sg.Name = "__XDM_FPS"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 999
    sg.IgnoreGuiInset = true
    pcall(function() sg.Parent = GUI end)

    local card = Instance.new("Frame")
    card.Size = UDim2.new(0, 110, 0, 34)
    card.Position = UDim2.new(1, -120, 0, 10)
    card.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
    card.BorderSizePixel = 0
    card.Active = true
    card.Parent = sg
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 210, 110)
    stroke.Thickness = 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = card

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(1, 0, 1, 0)
    val.BackgroundTransparency = 1
    val.TextColor3 = Color3.fromRGB(240, 240, 245)
    val.Font = Enum.Font.GothamBold
    val.TextSize = 13
    val.Text = "FPS: --"
    val.Parent = card

    local dragging, dragStart, startPos
    card.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = inp.Position; startPos = card.Position
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - dragStart
            card.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local fc, at = 0, 0
    Run.RenderStepped:Connect(function(dt)
        fc += 1; at += dt
        if at >= 0.5 then
            local fps = math.round(fc / at)
            val.Text = "FPS: " .. tostring(fps)
            local col = (fps >= 50 and Color3.fromRGB(0, 210, 110)) or (fps >= 30 and Color3.fromRGB(255, 185, 0)) or Color3.fromRGB(255, 55, 55)
            val.TextColor3 = col
            stroke.Color = col
            fc, at = 0, 0
        end
    end)
end)

