-- ── HAKI + HIDE OTHER PLAYERS ────────────────────────────────
local function isHakiObj(o)
    if (o:IsA("Highlight") or o:IsA("BillboardGui")) and not inProtected(o) then return true end
    return hasWord(o.Name,HAKI_W)
end
local function stripHaki(char)
    if not char then return end
    for _,o in ipairs(char:GetDescendants()) do
        if isHakiObj(o) then safeKill(o) end
    end
    char.DescendantAdded:Connect(function(o)
        task.defer(function()
            if o and o.Parent and isHakiObj(o) then safeKill(o) end
        end)
    end)
end
local function hideChar(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.1)
        for _,o in ipairs(char:GetDescendants()) do
            if o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation") then
                safeSet(o,"Transparency",1); safeSet(o,"CastShadow",false)
            elseif o:IsA("Decal") or o:IsA("Texture") then
                safeSet(o,"Transparency",1)
            elseif o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
                safeSet(o,"Enabled",false)
            elseif VFX[o.ClassName] then safeKill(o) end
        end
    end)
end
local function hookPlayer(plr)
    if plr == LP then return end
    local function onChar(char)
        task.wait(0.2); stripHaki(char); hideChar(char)
    end
    if plr.Character then task.spawn(onChar,plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end
for _,p in ipairs(Plr:GetPlayers()) do hookPlayer(p) end
Plr.PlayerAdded:Connect(hookPlayer)

