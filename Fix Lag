local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local KEEP_DELAY = 0.01

local function isBoat(model)
    if not model:IsA("Model") then
        return false
    end

    local n = string.lower(model.Name)

    if n:find("boat", 1, true)
        or n:find("ship", 1, true)
        or n:find("raft", 1, true)
        or n:find("dinghy", 1, true)
        or n:find("sail", 1, true) then
        return true
    end

    return model:FindFirstChildWhichIsA("VehicleSeat", true) ~= nil
end

local function isCharacter(model)
    return model:IsA("Model")
        and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function hasProtectedDescendant(obj)
    if obj:IsA("Model") then
        if isCharacter(obj) or isBoat(obj) then
            return true
        end
    end

    for _, child in ipairs(obj:GetChildren()) do
        if hasProtectedDescendant(child) then
            return true
        end
    end

    return false
end

local function cleanNode(obj)
    if not obj or not obj.Parent then
        return
    end

    if obj:IsA("Model") and (isCharacter(obj) or isBoat(obj)) then
        return
    end

    if not hasProtectedDescendant(obj) then
        obj:Destroy()
        return
    end

    for _, child in ipairs(obj:GetChildren()) do
        cleanNode(child)
        task.wait(KEEP_DELAY)
    end
end

local function cleanContainer(container)
    if not container then
        return
    end

    for _, child in ipairs(container:GetChildren()) do
        cleanNode(child)
        task.wait()
    end
end

local map = Workspace:FindFirstChild("Map")

if map then
    task.spawn(function()
        cleanContainer(map)
    end)
end

local possibleMaps = {
    Workspace:FindFirstChild("Environment"),
    Workspace:FindFirstChild("Map2"),
    Workspace:FindFirstChild("World"),
}

for _, container in ipairs(possibleMaps) do
    if container and container ~= map then
        task.spawn(function()
            cleanContainer(container)
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player.Character then
        player.Character.Archivable = true
    end
end

print("FULL MAP CLEANER: ON")
