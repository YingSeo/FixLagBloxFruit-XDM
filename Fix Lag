-- ── SOLID SEA FLOOR ───────────────────────────────────────────
--[[
    Nguyên tắc chống jitter:
    - Floor CanCollide=true xử lý collision tự nhiên qua engine
    - KHÔNG snap CFrame mỗi frame → không tug-of-war với physics
    - Chỉ dùng emergency snap khi Y < EMERGENCY_Y (rớt hẳn)
    - SetStateEnabled Swimming=false để engine không apply swim physics
    - Zero vertical velocity CHỈ 1 lần khi detect swimming, không loop
]]

local FLOOR_Y     = 1.5   -- mặt trên floor, nhân vật đứng ở đây
local FLOOR_NAME  = "__MrDonSea"
local EMERGENCY_Y = -10   -- chỉ snap khi rớt thực sự sâu

local function buildFloor()
    local existing = WS:FindFirstChild(FLOOR_NAME)
    if existing then safeKill(existing) end

    local p = Instance.new("Part")
    p.Name         = FLOOR_NAME
    p.Size         = Vector3.new(9e4, 10, 9e4)
    -- Đặt sao cho mặt TRÊN của part nằm tại Y = FLOOR_Y
    p.CFrame       = CFrame.new(0, FLOOR_Y - 5, 0)
    p.Transparency = 1
    p.Anchored     = true
    p.CanCollide   = true
    p.CanTouch     = false
    p.CanQuery     = false
    p.CastShadow   = false
    p.Massless     = true
    p.Material     = Enum.Material.SmoothPlastic
    p.Parent       = WS
end

local function nukeTerrainWater()
    local t = WS:FindFirstChildOfClass("Terrain")
    if not t then return end
    safeSet(t,"Decoration",false)
    safeSet(t,"WaterWaveSize",0)
    safeSet(t,"WaterWaveSpeed",0)
    safeSet(t,"WaterReflectance",0)
    safeSet(t,"WaterTransparency",1)
    local cl = t:FindFirstChildOfClass("Clouds")
    if cl then safeKill(cl) end
    pcall(function()
        local ext  = t.MaxExtents
        local mn,mx = ext.Min, ext.Max
        local rMin = Vector3.new(math.max(mn.X,-6000),math.max(mn.Y,-300),math.max(mn.Z,-6000))
        local rMax = Vector3.new(math.min(mx.X, 6000),math.min(mx.Y, 80), math.min(mx.Z, 6000))
        local region = Region3.new(rMin,rMax):ExpandToGrid(4)
        local mats,occs = t:ReadVoxels(region,4)
        local sx,sy,sz = mats.Size.X,mats.Size.Y,mats.Size.Z
        local dirty = false
        for x=1,sx do
            for y=1,sy do
                for z=1,sz do
                    if mats[x][y][z]==Enum.Material.Water then
                        mats[x][y][z]=Enum.Material.Air
                        occs[x][y][z]=0
                        dirty=true
                    end
                end
            end
            if x%8==0 then task.wait() end
        end
        if dirty then t:WriteVoxels(region,4,mats,occs) end
    end)
end

local function nukeWaterParts()
    local d = WS:GetDescendants()
    for i=1,#d do
        local o=d[i]
        if o and o.Parent and o:IsA("BasePart")
        and hasWord(o.Name,WATER_W) and not inProtected(o) then
            safeKill(o)
        end
        if i%100==0 then task.wait() end
    end
end

-- Disable swim state một lần khi char load, không loop
local function setupCharWater(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid",5)
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Swimming,false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Landed,true)
    end)

    -- Zero velocity một lần khi detect Swimming, rồi thôi
    hum.StateChanged:Connect(function(_,new)
        if new == Enum.HumanoidStateType.Swimming then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.new(
                        root.AssemblyLinearVelocity.X,
                        0,
                        root.AssemblyLinearVelocity.Z
                    )
                end)
            end
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end)
end

task.spawn(function()
    buildFloor()
    nukeTerrainWater()
    nukeWaterParts()
    if LP.Character then setupCharWater(LP.Character) end
    LP.CharacterAdded:Connect(function(c) task.spawn(setupCharWater,c) end)
end)

