local HAKI_W = {"aura","haki","kenbun","observe","kenbunshoku","v2effect","v3effect","v4effect"}

local function isHakiObj(o)
    if (o:IsA("Highlight") or o:IsA("BillboardGui")) and not inProtected(o) then return true end
    return hasWord(o.Name, HAKI_W)
end

local function stripHaki(char)
    if not char then return end
    for _,o in ipairs(char:GetDescendants()) do
        if isHakiObj(o) then safeKill(o) end
    end
    char.DescendantAdded:Connect(function(o)
        task.defer(function()
            if o and o.Parent and isHakiObj(o) then safeKill(o) end
        end)
    end)
end

local function hideChar(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.1)
        for _,o in ipairs(char:GetDescendants()) do
            if o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation") then
                safeSet(o,"Transparency",1); safeSet(o,"CastShadow",false)
            elseif o:IsA("Decal") or o:IsA("Texture") then
                safeSet(o,"Transparency",1)
            elseif o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
                safeSet(o,"Enabled",false)
            elseif VFX[o.ClassName] then safeKill(o) end
        end
    end)
end

local function hookPlayer(plr)
    if plr == LP then return end
    local function onChar(char)
        task.wait(0.2); stripHaki(char); hideChar(char)
    end
    if plr.Character then task.spawn(onChar, plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

for _,p in ipairs(Plr:GetPlayers()) do hookPlayer(p) end
Plr.PlayerAdded:Connect(hookPlayer)

do
    local SURF_Y, WALK_OFF, SINK_THR, DBNC = nil, 3.0, -0.8, 0.3
    local lastFix = 0
    local gp = RaycastParams.new()
    gp.FilterType = Enum.RaycastFilterType.Exclude

    task.spawn(function()
        local r = WS:Raycast(Vector3.new(0,2000,0), Vector3.new(0,-4000,0), gp)
        SURF_Y = r and r.Position.Y or 0
    end)

    Run.Heartbeat:Connect(function()
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health<=0 then return end
        if hum:GetState() ~= Enum.HumanoidStateType.Swimming then return end

        local now = tick()
        if now - lastFix < DBNC then return end

        if not SURF_Y then
            gp.FilterDescendantsInstances = {char}
            local r = WS:Raycast(root.Position+Vector3.new(0,200,0), Vector3.new(0,-400,0), gp)
            SURF_Y = r and r.Position.Y or 0
        end

        local targetY = SURF_Y + WALK_OFF
        if root.Position.Y < targetY + SINK_THR then
            lastFix = now
            pcall(function()
                local _,ry,_ = root.CFrame:ToEulerAnglesYXZ()
                root.CFrame = CFrame.new(root.Position.X, targetY, root.Position.Z)
                           * CFrame.Angles(0,ry,0)
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
            end)
            task.delay(0.05, function()
                if hum and hum.Health>0 then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
                end
            end)
        end
    end)
end

do
    local prevLook = Vector3.new(0,0,-1)
    Run.RenderStepped:Connect(function()
        local cam = WS.CurrentCamera
        if not cam then return end
        purgeCamera()
        local look = cam.CFrame.LookVector
        if look ~= prevLook then
            prevLook = look
            local p = cam.CFrame.Position
            cam.CFrame = CFrame.new(p, p+look)
        end
    end)
end

