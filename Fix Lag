end)

-- ── VFX PURGE ────────────────────────────────────────────────
local function purgeCamera()
    local cam = WS.CurrentCamera
    if not cam then return end
    for _,o in ipairs(cam:GetChildren()) do
        if VFX[o.ClassName] or LFX[o.ClassName] then safeKill(o) end
    end
end

task.spawn(function()
    local d = WS:GetDescendants()
    for i=1,#d do
        local o = d[i]
        if o and o.Parent and VFX[o.ClassName] and not inProtected(o) then safeKill(o) end
        if i%100==0 then task.wait() end
    end
end)

WS.DescendantAdded:Connect(function(o)
    task.delay(0, function()
        if o and o.Parent and VFX[o.ClassName] and not inProtected(o) then
            safeKill(o)
        end
    end)
end)

-- ── MAP CLEAN ────────────────────────────────────────────────
local function cleanFolder(parent)
    local list = parent:GetChildren()
    for i=1,#list do
        local o = list[i]
        if o and o.Parent then
            if not keepTree(o) then
                if hasProtectedChild(o) then cleanFolder(o)
                else safeKill(o) end
            end
        end
        if i%50==0 then task.wait() end
    end
end

task.spawn(function()
    for _,name in ipairs({"Map","SeaMap","Environment","World","Map2","Map3","Islands"}) do
        local c = WS:FindFirstChild(name)
        if c then task.spawn(cleanFolder,c) end
    end
end)

-- ── OVERLAY STRIP ────────────────────────────────────────────
local OVL_W = {
    "v4vignette","racevignette","screenvignette","darkscreenvignette",
    "blackscreenoverlay","fogoverlay","mistoverlay","terrosharkscreen",
    "seabeastscreen","cinematicoverlay","cutsceneoverlay"
}

local function isUserMenuGui(o)
    local root = o
    while root.Parent and root.Parent ~= targetParent and root.Parent ~= game do
        root = root.Parent
    end
    
    local rootName = norm(root.Name)
    if rootName:sub(1,2) == "__" 
    or rootName:find("menu",1,true) 
    or rootName:find("hub",1,true) 
    or rootName:find("ui",1,true)
    or rootName:find("gui",1,true)
    or rootName:find("rayfield",1,true)
    or rootName:find("orion",1,true)
    or rootName:find("fluent",1,true)
    or rootName:find("kavo",1,true)
    or rootName:find("redz",1,true) then
        return true
    end
    return false
end

local function isOverlay(o)
    if isUserMenuGui(o) then return false end
    if not (o:IsA("Frame") or o:IsA("ImageLabel") or o:IsA("ScreenGui") or o:IsA("ImageButton")) then 
        return false 
    end
    return hasWord(o.Name, OVL_W)
end

local function stripOverlay(gui)
    if not gui then return end
    for _,o in ipairs(gui:GetChildren()) do
        if isOverlay(o) then
            safeSet(o,"Visible",false)
            safeSet(o,"BackgroundTransparency",1)
            safeSet(o,"ImageTransparency",1)
        end
    end
end

if targetParent then
    stripOverlay(targetParent)
    targetParent.DescendantAdded:Connect(function(o)
        task.delay(0, function()
            if o and o.Parent and isOverlay(o) then
                safeSet(o,"Visible",false)
                safeSet(o,"BackgroundTransparency",1)
                safeSet(o,"ImageTransparency",1)
            end
        end)
    end)
    task.spawn(function()
        while true do task.wait(3) stripOverlay(targetParent) end
    end)
end

-- ── DAMAGE GUI STRIP ─────────────────────────────────────────
local DMG_W = {
    "damageindicator","floatingdamagetext","combatdamagetext","hitdamagepopup"
}

local function isDmgGui(o) 
    if isUserMenuGui(o) then return false end
    return hasWord(o.Name, DMG_W) 
end

local function killDmgGui(o)
    if isDmgGui(o) then
        if o:IsA("BillboardGui") or o:IsA("ScreenGui")
        or o:IsA("SurfaceGui") or o:IsA("TextLabel")
        or o:IsA("Frame") or o:IsA("ImageLabel") then
            safeSet(o,"Enabled",false); safeSet(o,"Visible",false)
        end
    end
end

if targetParent then
    for _,o in ipairs(targetParent:GetDescendants()) do killDmgGui(o) end
    targetParent.DescendantAdded:Connect(function(o)
        task.delay(0, function() if o and o.Parent then killDmgGui(o) end end)
    end)
end
WS.DescendantAdded:Connect(function(o)
    task.delay(0, function()
        if o and o.Parent and isDmgGui(o) then
            if o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
                safeSet(o,"Enabled",false)
            end
        end
    end)
end)

-- ── HAKI + HIDE OTHER PLAYERS ────────────────────────────────
local HAKI_W = {"aura","haki","kenbun","observe","kenbunshoku","v2effect","v3effect","v4effect"}

local function isHakiObj(o)
    if (o:IsA("Highlight") or o:IsA("BillboardGui")) and not inProtected(o) then return true end
    return hasWord(o.Name, HAKI_W)
end

local function stripHaki(char)
    if not char then return end
    for _,o in ipairs(char:GetDescendants()) do
        if isHakiObj(o) then safeKill(o) end
    end
    char.DescendantAdded:Connect(function(o)
        task.delay(0, function()
            if o and o.Parent and isHakiObj(o) then safeKill(o) end
        end)
    end)
end

local function hideChar(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.1)
        for _,o in ipairs(char:GetDescendants()) do
            if o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation") then
                safeSet(o,"Transparency",1); safeSet(o,"CastShadow",false)
            elseif o:IsA("Decal") or o:IsA("Texture") then
                safeSet(o,"Transparency",1)
            elseif o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
                safeSet(o,"Enabled",false)
            elseif VFX[o.ClassName] then safeKill(o) end
        end
    end)
end

local function hookPlayer(plr)
    if plr == LP then return end
    local function onChar(char)
        task.wait(0.2); stripHaki(char); hideChar(char)
    end
    if plr.Character then task.spawn(onChar, plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

for _,p in ipairs(Plr:GetPlayers()) do hookPlayer(p) end
Plr.PlayerAdded:Connect(hookPlayer)

-- ── WATER WALK PLATFORM ───────────────────────────────────────
local SEA_LEVEL = 0
local currentFloor = nil
local floorConn = nil

local function removeFloor()
    if floorConn then
        floorConn:Disconnect()
        floorConn = nil
    end
    if currentFloor and currentFloor.Parent then
        safeKill(currentFloor)
    end
    currentFloor = nil
end

local function spawnFloor(char)
    removeFloor()

    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum  = char:WaitForChild("Humanoid", 5)
    if not root or not hum then return end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
    end)

    local floor = Instance.new("Part")
    floor.Name            = "__WaterFloor"
    floor.Size            = Vector3.new(400, 3, 400)
    floor.Transparency    = 1
    floor.CanCollide      = true
    floor.Anchored        = true
    floor.CastShadow      = false
    floor.CanTouch        = false
    floor.CanQuery        = false
    floor.Massless        = true
    floor.Material        = Enum.Material.SmoothPlastic
    
    local targetFloorY = SEA_LEVEL - 1.0
    floor.CFrame          = CFrame.new(root.Position.X, targetFloorY, root.Position.Z)
    floor.Parent          = WS

    currentFloor = floor

    floorConn = Run.Stepped:Connect(function()
        if not (floor and floor.Parent and root and root.Parent) then
            removeFloor()
            return
        end
        
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Swimming then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        local rootY = root.Position.Y
        local floorY = targetFloorY
        
        if rootY - 3.2 < SEA_LEVEL then
            floorY = rootY - 3.2
        end

        floor.CFrame = CFrame.new(root.Position.X, floorY, root.Position.Z)
    end)

    hum.Died:Connect(removeFloor)
    char.AncestryChanged:Connect(function()
        if not char.Parent then removeFloor() end
    end)
end

local function onLocalChar(char)
    task.wait(0.2)
    spawnFloor(char)
end

if LP.Character then task.spawn(onLocalChar, LP.Character) end
LP.CharacterAdded:Connect(onLocalChar)

-- ── CAMERA ANTI-SHAKE ─────────────────────────────────────────
do
    local prevLook = Vector3.new(0,0,-1)
    Run.RenderStepped:Connect(function()
        local cam = WS.CurrentCamera
        if not cam then return end
        purgeCamera()
        local look = cam.CFrame.LookVector
        if look ~= prevLook then
            prevLook = look
            local p = cam.CFrame.Position
            cam.CFrame = CFrame.new(p, p+look)
        end
    end)
end

