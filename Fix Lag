local Players     = game:GetService("Players")
local Workspace   = game:GetService("Workspace")
local Lighting    = game:GetService("Lighting")
local RunService  = game:GetService("RunService")

repeat task.wait() until game:IsLoaded()

local LP = Players.LocalPlayer

local SPECIAL_MAPS = {
    frozendimension   = true,
    prehistoricisland = true,
    kitsuneisland     = true,
}

local KEEP_CONTAINERS = {
    enemies    = true, enemy      = true,
    characters = true, character  = true,
    npcs       = true, npc        = true,
    boats      = true, boat       = true,
    ships      = true, ship       = true,
}

local VFX_CLASSES = {
    ParticleEmitter  = true, Beam            = true,
    Trail            = true, Fire            = true,
    Smoke            = true, Sparkles        = true,
    SelectionBox     = true, SelectionSphere = true,
}

local LIGHTING_FX = {
    ColorCorrectionEffect = true, BloomEffect       = true,
    BlurEffect            = true, SunRaysEffect      = true,
    DepthOfFieldEffect    = true, Sky                = true,
    Atmosphere            = true,
}

local HAKI_PATTERNS = {
    "aura", "haki", "kenbun", "observe", "kenbunshoku",
    "v2effect", "v3effect", "v4effect",
}

local function norm(s)
    return s:lower():gsub("[^%w]", "")
end

local function isSpecial(name)
    local n = norm(name)
    if SPECIAL_MAPS[n] then return true end
    for k in next, SPECIAL_MAPS do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function isBoat(obj)
    if not obj:IsA("Model") then return false end
    local n = norm(obj.Name)
    if n:find("boat",1,true) or n:find("ship",1,true)
    or n:find("raft",1,true) or n:find("dinghy",1,true) then return true end
    return obj:FindFirstChildWhichIsA("VehicleSeat", true) ~= nil
end

local function isProtected(obj)
    if not obj:IsA("Model") then return false end
    if obj:FindFirstChildOfClass("Humanoid") then return true end
    if isBoat(obj) then return true end
    if isSpecial(obj.Name) then return true end
    return false
end

local function keepTree(obj)
    if obj:IsA("Model") then return isProtected(obj) end
    return KEEP_CONTAINERS[norm(obj.Name)] == true
end

local function hasProtected(obj)
    if keepTree(obj) then return true end
    for _, c in ipairs(obj:GetChildren()) do
        if keepTree(c) or hasProtected(c) then return true end
    end
    return false
end

local function inProtectedTree(obj)
    local p = obj.Parent
    while p and p ~= Workspace and p ~= game do
        if keepTree(p) then return true end
        p = p.Parent
    end
    return false
end

local function cleanFolder(parent)
    local list = parent:GetChildren()
    for i = 1, #list do
        local obj = list[i]
        if obj and obj.Parent then
            if keepTree(obj) then
            elseif hasProtected(obj) then
                cleanFolder(obj)
            else
                pcall(function() obj:Destroy() end)
            end
        end
        if i % 50 == 0 then task.wait() end
    end
end

task.spawn(function()
    local roots = {"Map","SeaMap","Environment","World","Map2","Map3","Islands"}
    for _, name in ipairs(roots) do
        local c = Workspace:FindFirstChild(name)
        if c then task.spawn(cleanFolder, c) end
    end
end)

do
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        local cl = terrain:FindFirstChildOfClass("Clouds")
        if cl then pcall(function() cl:Destroy() end) end
        pcall(function() terrain.Decoration = false end)
        pcall(function() terrain.WaterWaveSize = 0 end)
        pcall(function() terrain.WaterWaveSpeed = 0 end)
        pcall(function() terrain.WaterReflectance = 0 end)
        pcall(function() terrain.WaterTransparency = 1 end)
    end

    for cls in next, LIGHTING_FX do
        local o = Lighting:FindFirstChildOfClass(cls)
        if o then pcall(function() o:Destroy() end) end
    end

    Lighting.GlobalShadows = false
    Lighting.FogEnd        = 100000
    Lighting.FogStart      = 99999
    Lighting.Brightness    = 2
    Lighting.ClockTime     = 14
    Lighting.Ambient       = Color3.fromRGB(178, 178, 178)
    Lighting.OutdoorAmbient= Color3.fromRGB(178, 178, 178)
end

local function purgeFX(parent)
    if not parent then return end
    for _, obj in ipairs(parent:GetChildren()) do
        if LIGHTING_FX[obj.ClassName] or VFX_CLASSES[obj.ClassName] then
            pcall(function() obj:Destroy() end)
        end
    end
end

purgeFX(Workspace.CurrentCamera)
purgeFX(Lighting)

Lighting.ChildAdded:Connect(function(obj)
    if LIGHTING_FX[obj.ClassName] then
        task.defer(function()
            if obj and obj.Parent then
                pcall(function() obj:Destroy() end)
            end
        end)
    end
end)

task.spawn(function()
    local desc = Workspace:GetDescendants()
    for i = 1, #desc do
        local obj = desc[i]
        if obj and obj.Parent and VFX_CLASSES[obj.ClassName] then
            if not inProtectedTree(obj) then
                pcall(function() obj:Destroy() end)
            end
        end
        if i % 80 == 0 then task.wait() end
    end
end)

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if not (obj and obj.Parent) then return end
        if VFX_CLASSES[obj.ClassName] and not inProtectedTree(obj) then
            pcall(function() obj:Destroy() end)
        end
    end)
end)

local function isHakiObj(obj)
    if obj:IsA("Highlight") or obj:IsA("BillboardGui") then
        return not inProtectedTree(obj) and true
    end
    local n = norm(obj.Name)
    for _, p in ipairs(HAKI_PATTERNS) do
        if n:find(p, 1, true) then return true end
    end
    return false
end

local function stripHaki(char)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if isHakiObj(obj) then pcall(function() obj:Destroy() end) end
    end
    char.DescendantAdded:Connect(function(obj)
        task.defer(function()
            if obj and obj.Parent and isHakiObj(obj) then
                pcall(function() obj:Destroy() end)
            end
        end)
    end)
end

local function hideChar(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.1)
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
                pcall(function()
                    obj.Transparency = 1
                    obj.CastShadow   = false
                end)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                pcall(function() obj.Transparency = 1 end)
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                pcall(function() obj.Enabled = false end)
            elseif VFX_CLASSES[obj.ClassName] then
                pcall(function() obj:Destroy() end)
            end
        end
    end)
end

local function hookPlayer(plr)
    if plr == LP then return end
    local function onChar(char)
        task.wait(0.2)
        stripHaki(char)
        hideChar(char)
    end
    if plr.Character then task.spawn(onChar, plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end
Players.PlayerAdded:Connect(hookPlayer)

do
    local prevLook = Vector3.new(0, 0, -1)
    RunService.RenderStepped:Connect(function()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local look = cam.CFrame.LookVector
        if look ~= prevLook then
            prevLook = look
            local pos = cam.CFrame.Position
            cam.CFrame = CFrame.new(pos, pos + look)
        end
        purgeFX(cam)
    end)
end

pcall(function() setfpscap(480) end)
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

print("[MrDon] Script loaded — Delta X / Blox Fruits")
