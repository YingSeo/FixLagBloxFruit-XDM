local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local DELETE_BATCH = 2000
local DELETE_YIELD = 0.01

local protected = {}
local queue = {}
local deleting = true

local function nameHas(name, ...)
    name = string.lower(name)

    for i = 1, select("#", ...) do
        local word = string.lower(select(i, ...))
        if string.find(name, word, 1, true) then
            return true
        end
    end

    return false
end

local function isProtectedModel(obj)
    if not obj:IsA("Model") then
        return false
    end

    if obj:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if obj:FindFirstChildWhichIsA("VehicleSeat", true) then
        return true
    end

    if nameHas(obj.Name, "boat", "ship", "raft", "dinghy") then
        return true
    end

    if LocalPlayer.Character and obj == LocalPlayer.Character then
        return true
    end

    return false
end

local function markProtected(obj)
    if not obj:IsA("Model") then
        return
    end

    if not isProtectedModel(obj) then
        return
    end

    local current = obj

    while current and current ~= Workspace do
        protected[current] = true
        current = current.Parent
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("Model") then
        markProtected(obj)
    end
end

local function destroyTree(parent)
    local children = parent:GetChildren()

    for i = 1, #children do
        local obj = children[i]

        if obj and obj.Parent then
            if not protected[obj] then
                obj:Destroy()
            else
                destroyTree(obj)
            end
        end

        if i % DELETE_BATCH == 0 then
            task.wait(DELETE_YIELD)
        end
    end
end

local keepContainers = {
    Camera = true,
    Terrain = true,
    CurrentCamera = true
}

task.spawn(function()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if not keepContainers[obj.Name] and not protected[obj] then
            obj:Destroy()
        elseif protected[obj] then
            destroyTree(obj)
        end

        task.wait()
    end

    deleting = false
end)

local floor = Instance.new("Part")
floor.Name = "ClientInvisibleFloor"
floor.Anchored = true
floor.CanCollide = true
floor.CanTouch = false
floor.CanQuery = true
floor.Transparency = 1
floor.Size = Vector3.new(2048, 1, 2048)
floor.Parent = Workspace

local function updateFloor()
    local character = LocalPlayer.Character
    if not character then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    local p = root.Position
    floor.CFrame = CFrame.new(p.X, p.Y - 3.1, p.Z)
end

RunService.Heartbeat:Connect(updateFloor)

local gui = Instance.new("ScreenGui")
gui.Name = "ClientFPS"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 125, 0, 38)
frame.Position = UDim2.new(1, -135, 0, 10)
frame.BackgroundTransparency = 0.25
frame.BorderSizePixel = 0
frame.Parent = gui

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, -10, 1, -6)
label.Position = UDim2.new(0, 5, 0, 3)
label.BackgroundTransparency = 1
label.Text = "FPS: --"
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.TextColor3 = Color3.new(1, 1, 1)
label.Parent = frame

local frames = 0
local elapsed = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt

    if elapsed >= 0.5 then
        local fps = math.floor(frames / elapsed + 0.5)
        label.Text = "FPS: " .. fps

        frames = 0
        elapsed = 0
    end
end)
