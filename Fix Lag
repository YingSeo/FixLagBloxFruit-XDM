-- Failsafe RenderStepped: nếu nhân vật vẫn lọt xuống nước → kéo lên
do
    local SNAP_Y   = FLOOR_Y + 3.2
    local SNAP_LIM = 0.8

    Run.RenderStepped:Connect(function()
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end

        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Swimming
        or root.Position.Y < FLOOR_Y + SNAP_LIM then
            pcall(function()
                local _,ry,_ = root.CFrame:ToEulerAnglesYXZ()
                root.CFrame  = CFrame.new(
                    root.Position.X, SNAP_Y, root.Position.Z
                ) * CFrame.Angles(0,ry,0)
            end)
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end)
end
