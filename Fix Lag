local frames = 0
local elapsed = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt

    if elapsed >= 0.5 then
        label.Text = "FPS: " .. tostring(math.floor(frames / elapsed + 0.5))
        frames = 0
        elapsed = 0
    end
end)

print("MrDon Optimizer ON")
