-- ── WATER → SOLID FLOOR (Core Logic) ─────────────────────────
--[[
    Chiến lược:
    1. Terrain: replace toàn bộ vùng Water bằng SmoothPlastic
       dùng ReadVoxels/WriteVoxels để giữ địa hình, chỉ đổi material
    2. Invisible Part sàn Y=0 toàn cầu: fallback đảm bảo 100%
    3. Disable HumanoidStateType.Swimming vĩnh viễn trên LP
    4. Force Humanoid ra khỏi Swimming state mỗi frame nếu lọt xuống
]]

local FLOOR_Y       = 0
local FLOOR_NAME    = "__MrDonSolidSea"
local VOXEL_SIZE    = 4
local FILL_MATERIAL = Enum.Material.SmoothPlastic

local function buildSolidFloor()
    if WS:FindFirstChild(FLOOR_NAME) then return end
    local floor = Instance.new("Part")
    floor.Name             = FLOOR_NAME
    floor.Size             = Vector3.new(8000, 4, 8000)
    floor.CFrame           = CFrame.new(0, FLOOR_Y - 2, 0)
    floor.Transparency     = 1
    floor.Anchored         = true
    floor.CanCollide       = true
    floor.CanTouch         = false
    floor.CanQuery         = false
    floor.CastShadow       = false
    floor.Massless         = true
    floor.Material         = FILL_MATERIAL
    floor.CollisionGroupId = 0
    floor.Parent           = WS
end

local function replaceTerrainWater()
    local terrain = WS:FindFirstChildOfClass("Terrain")
    if not terrain then return end

    safeSet(terrain,"Decoration",false)
    safeSet(terrain,"WaterWaveSize",0)
    safeSet(terrain,"WaterWaveSpeed",0)
    safeSet(terrain,"WaterReflectance",0)
    safeSet(terrain,"WaterTransparency",1)

    local cl = terrain:FindFirstChildOfClass("Clouds")
    if cl then safeKill(cl) end

    -- ReadVoxels toàn bộ extent của map, swap Water → SmoothPlastic
    pcall(function()
        local ext = terrain.MaxExtents
        local minP = ext.Min
        local maxP = ext.Max

        -- Clamp vùng scan hợp lý tránh timeout
        local scanMin = Vector3.new(
            math.max(minP.X, -4000),
            math.max(minP.Y, -200),
            math.max(minP.Z, -4000)
        )
        local scanMax = Vector3.new(
            math.min(maxP.X,  4000),
            math.min(maxP.Y,  50),
            math.min(maxP.Z,  4000)
        )

        local region = Region3.new(scanMin, scanMax):ExpandToGrid(VOXEL_SIZE)
        local mats, occs = terrain:ReadVoxels(region, VOXEL_SIZE)

        local sx,sy,sz = mats.Size.X, mats.Size.Y, mats.Size.Z
        local changed  = false

        for x=1,sx do
            for y=1,sy do
                for z=1,sz do
                    if mats[x][y][z] == Enum.Material.Water then
                        mats[x][y][z] = Enum.Material.Air
                        occs[x][y][z] = 0
                        changed = true
                    end
                end
            end
            -- yield mỗi slice X để không lag
            if x % 10 == 0 then task.wait() end
        end

        if changed then
            terrain:WriteVoxels(region, VOXEL_SIZE, mats, occs)
        end
    end)
end

-- Xóa BasePart tên chứa water/ocean/sea/wave
local function nukeWaterParts()
    local d = WS:GetDescendants()
    for i=1,#d do
        local o = d[i]
        if o and o.Parent and o:IsA("BasePart")
        and hasWord(o.Name,WATER_W) and not inProtected(o) then
            safeKill(o)
        end
        if i%100==0 then task.wait() end
    end
end

-- Disable Swimming state + force out mỗi khi nhân vật spawn
local function disableSwimming(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid",5)
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    end)
end

-- Chạy toàn bộ water pipeline
task.spawn(function()
    buildSolidFloor()
    replaceTerrainWater()
    nukeWaterParts()
    if LP.Character then disableSwimming(LP.Character) end
    LP.CharacterAdded:Connect(function(char)
        task.spawn(disableSwimming, char)
    end)
end)

