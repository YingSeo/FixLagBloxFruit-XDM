local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CẤU HÌNH
--------------------------------------------------

local ENABLED = true

-- Tên object/model chắc chắn không được ẩn
local KEEP_NAMES = {
    Camera = true,
    Terrain = true,

    -- Các container NPC thường gặp
    Enemies = true,
    Enemy = true,
    NPCs = true,
    NPC = true,
    Characters = true,

    -- Container thuyền
    Boats = true,
    Boat = true,
    Ships = true,
    Ship = true,
}

--------------------------------------------------
-- KIỂM TRA NPC
--------------------------------------------------

local function isNPCOrCharacter(obj)
    local current = obj

    while current and current ~= Workspace do
        if current:IsA("Model") then
            -- Có Humanoid = NPC hoặc Character
            if current:FindFirstChildOfClass("Humanoid") then
                return true
            end

            local name = string.lower(current.Name)

            if name == "enemies"
                or name == "enemy"
                or name == "npcs"
                or name == "npc"
                or name == "characters" then
                return true
            end
        end

        current = current.Parent
    end

    return false
end

--------------------------------------------------
-- KIỂM TRA THUYỀN
--------------------------------------------------

local function isBoatOrShip(obj)
    local current = obj

    while current and current ~= Workspace do
        if current:IsA("Model") then

            local name = string.lower(current.Name)

            -- Bắt model có chữ boat / ship
            if string.find(name, "boat", 1, true)
                or string.find(name, "ship", 1, true) then
                return true
            end

            -- Thuyền thường có VehicleSeat
            if current:FindFirstChildWhichIsA("VehicleSeat", true) then
                return true
            end

            -- Một số thuyền sử dụng Seat
            local seat = current:FindFirstChildWhichIsA("Seat", true)
            if seat then
                return true
            end
        end

        current = current.Parent
    end

    return false
end

--------------------------------------------------
-- KIỂM TRA OBJECT CẦN GIỮ
--------------------------------------------------

local function shouldKeep(obj)

    if not obj then
        return true
    end

    -- Tên được whitelist
    if KEEP_NAMES[obj.Name] then
        return true
    end

    -- NPC / Player
    if isNPCOrCharacter(obj) then
        return true
    end

    -- Thuyền
    if isBoatOrShip(obj) then
        return true
    end

    -- Character của người chơi
    if LocalPlayer.Character
        and obj:IsDescendantOf(LocalPlayer.Character) then
        return true
    end

    return false
end

--------------------------------------------------
-- ẨN MAP
--------------------------------------------------

local function optimize(obj)

    if not ENABLED then
        return
    end

    -- Tuyệt đối không đụng NPC / Character / Boat
    if shouldKeep(obj) then
        return
    end

    ------------------------------------------------
    -- PART
    ------------------------------------------------

    if obj:IsA("BasePart") then
        obj.LocalTransparencyModifier = 1

        -- giảm physics query
        obj.CanCollide = false
        obj.CanTouch = false
        obj.CanQuery = false

        -- không render shadow
        obj.CastShadow = false
    end

    ------------------------------------------------
    -- DECAL / TEXTURE
    ------------------------------------------------

    if obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1
    end

    ------------------------------------------------
    -- EFFECT
    ------------------------------------------------

    if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then

        obj.Enabled = false
    end

    ------------------------------------------------
    -- LIGHT
    ------------------------------------------------

    if obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then

        obj.Enabled = false
    end

    ------------------------------------------------
    -- GUI TRONG MAP
    ------------------------------------------------

    if obj:IsA("BillboardGui")
        or obj:IsA("SurfaceGui") then

        obj.Enabled = false
    end

    ------------------------------------------------
    -- HIGHLIGHT
    ------------------------------------------------

    if obj:IsA("Highlight") then
        obj.Enabled = false
    end
end

--------------------------------------------------
-- QUÉT MAP HIỆN TẠI
--------------------------------------------------

for _, obj in ipairs(Workspace:GetDescendants()) do
    optimize(obj)
end

--------------------------------------------------
-- OBJECT MỚI SPAWN
--------------------------------------------------

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        optimize(obj)
    end)
end)

print("================================")
print(" Blox Fruits Map Optimizer")
print(" NPC     : KEPT")
print(" PLAYER  : KEPT")
print(" BOAT    : KEPT")
print(" MAP     : HIDDEN")
print("================================")
