-- ── MOB XẤU + XÓA SKILL VFX CỦA MOB ─────────────────────────
local uglyMobs = {}

local function uglyMob(model)
    if uglyMobs[model] then return end
    uglyMobs[model] = true

    task.spawn(function()
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
                pcall(function()
                    obj.Color        = UGLY
                    obj.Material     = Enum.Material.SmoothPlastic
                    obj.Reflectance  = 0
                    obj.CastShadow   = false
                end)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                pcall(function()
                    obj.Transparency = 1
                end)
            elseif VFX_CLASSES[obj.ClassName] then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                pcall(function() obj.Enabled = false end)
            end
        end

        model.DescendantAdded:Connect(function(obj)
            task.defer(function()
                if not (obj and obj.Parent) then return end
                if VFX_CLASSES[obj.ClassName] then
                    pcall(function() obj:Destroy() end)
                elseif obj:IsA("BasePart") or obj:IsA("MeshPart") then
                    pcall(function()
                        obj.Color       = UGLY
                        obj.Material    = Enum.Material.SmoothPlastic
                        obj.CastShadow  = false
                    end)
                end
            end)
        end)
    end)
end

local function scanSeaMobs(parent)
    if not parent then return end
    for _, obj in ipairs(parent:GetDescendants()) do
        if isSeaMob(obj) then uglyMob(obj) end
    end
end

task.spawn(function() scanSeaMobs(Workspace) end)

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if obj and obj.Parent and isSeaMob(obj) then
            uglyMob(obj)
        end
    end)
end)
