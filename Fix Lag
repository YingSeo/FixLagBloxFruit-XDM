local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local map = Workspace:FindFirstChild("Map")

if not map then
    warn("Không tìm thấy Workspace.Map")
    return
end

local queue = {}
local head = 1
local running = true

local BATCH_SIZE = 150

local function isProtectedModel(model)
    if not model or not model:IsA("Model") then
        return false
    end

    local name = string.lower(model.Name)

    if name:find("boat", 1, true)
        or name:find("ship", 1, true)
        or name:find("raft", 1, true) then
        return true
    end

    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if model:FindFirstChildWhichIsA("VehicleSeat", true) then
        return true
    end

    return false
end

local function isProtected(obj)
    if player.Character and obj:IsDescendantOf(player.Character) then
        return true
    end

    local current = obj

    while current and current ~= map do
        if current:IsA("Model") and isProtectedModel(current) then
            return true
        end

        current = current.Parent
    end

    return false
end

local function optimize(obj)
    if not obj or not obj.Parent or isProtected(obj) then
        return
    end

    if obj:IsA("BasePart") then
        obj.LocalTransparencyModifier = 1
        obj.CastShadow = false

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1

    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then
        obj.Enabled = false

    elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
        obj.Enabled = false
    end
end

for _, obj in ipairs(map:GetChildren()) do
    queue[#queue + 1] = obj
end

task.spawn(function()
    while running and head <= #queue do
        local endIndex = math.min(head + BATCH_SIZE - 1, #queue)

        for i = head, endIndex do
            local obj = queue[i]

            if obj and obj.Parent then
                optimize(obj)

                if obj:IsA("Folder") or obj:IsA("Model") then
                    for _, child in ipairs(obj:GetChildren()) do
                        queue[#queue + 1] = child
                    end
                end
            end
        end

        head = endIndex + 1

        if head <= #queue then
            task.wait()
        end
    end

    running = false
end)

map.ChildAdded:Connect(function(obj)
    if running then
        queue[#queue + 1] = obj
    end
end)

print("Fast map optimizer started")
