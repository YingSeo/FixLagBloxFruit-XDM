local WATER_W = {"water","ocean","sea","wave"}

local function isWaterPart(o)
    return o:IsA("BasePart") and hasWord(o.Name, WATER_W) and not inProtected(o)
end

task.spawn(function()
    local t = WS:FindFirstChildOfClass("Terrain")
    if t then
        safeSet(t,"Decoration",false)
        safeSet(t,"WaterWaveSize",0)
        safeSet(t,"WaterWaveSpeed",0)
        safeSet(t,"WaterReflectance",0)
