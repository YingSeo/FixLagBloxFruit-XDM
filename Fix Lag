local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local runtime = Workspace:FindFirstChild("MrDonRuntime")

if runtime then
    runtime:Destroy()
end

runtime = Instance.new("Folder")
runtime.Name = "MrDonRuntime"
runtime.Parent = Workspace

local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

local floor = Instance.new("Part")
floor.Name = "WaterFloor"
floor.Anchored = true
floor.CanCollide = true
floor.CanTouch = false
floor.CanQuery = true
floor.Transparency = 1
floor.Size = Vector3.new(8192, 4, 8192)
floor.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.5, root.Position.Z)
floor.Parent = runtime

local function updateFloor()
    local c = player.Character
    if not c then
        return
    end

    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then
        return
    end

    local p = r.Position
    floor.CFrame = CFrame.new(p.X, p.Y - 3.5, p.Z)
end

RunService.Heartbeat:Connect(updateFloor)

local gui = Instance.new("ScreenGui")
gui.Name = "MrDonFPS"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local box = Instance.new("Frame")
box.Size = UDim2.fromOffset(115, 36)
box.Position = UDim2.new(1, -125, 0, 10)
box.BackgroundTransparency = 0.2
box.BorderSizePixel = 0
box.ZIndex = 999999
box.Parent = gui

local text = Instance.new("TextLabel")
text.Size = UDim2.fromScale(1, 1)
text.BackgroundTransparency = 1
text.Text = "FPS: --"
text.TextScaled = true
text.Font = Enum.Font.GothamBold
text.TextColor3 = Color3.new(1, 1, 1)
text.ZIndex = 1000000
text.Parent = box

local frames = 0
local timePassed = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    timePassed += dt

    if timePassed >= 0.5 then
        text.Text = "FPS: " .. math.floor(frames / timePassed + 0.5)
        frames = 0
        timePassed = 0
    end
end)

local function isProtectedModel(obj)
    if not obj:IsA("Model") then
        return false
    end

    if obj:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if obj:FindFirstChildWhichIsA("VehicleSeat", true) then
        return true
    end

    local name = string.lower(obj.Name)

    return name:find("boat", 1, true) ~= nil
        or name:find("ship", 1, true) ~= nil
        or name:find("raft", 1, true) ~= nil
end

local protected = {}

for _, obj in ipairs(Workspace:GetChildren()) do
    if isProtectedModel(obj) then
        protected[obj] = true
    end
end

local function removeContainer(obj)
    if not obj or not obj.Parent then
        return
    end

    if obj == runtime
        or obj == Workspace.Terrain
        or obj == Workspace.CurrentCamera
        or protected[obj] then
        return
    end

    obj:Destroy()
end

task.spawn(function()
    local children = Workspace:GetChildren()

    for i = 1, #children do
        removeContainer(children[i])
    end
end)

player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter

    task.defer(function()
        local newRoot = newCharacter:WaitForChild("HumanoidRootPart", 5)

        if newRoot then
            floor.CFrame = CFrame.new(
                newRoot.Position.X,
                newRoot.Position.Y - 3.5,
                newRoot.Position.Z
            )
        end
    end)
end)

print("MrDon Cleaner ON")
