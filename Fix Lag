-- Emergency snap — chỉ kích hoạt khi rớt thật sự sâu (< -10)
-- Không chạy mỗi frame, dùng heartbeat thay stepped để nhẹ hơn
Run.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    if root.Position.Y < EMERGENCY_Y then
        pcall(function()
            local _,ry,_ = root.CFrame:ToEulerAnglesYXZ()
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(root.Position.X, FLOOR_Y + 5, root.Position.Z)
                        * CFrame.Angles(0,ry,0)
        end)
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end)

