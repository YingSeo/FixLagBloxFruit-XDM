-- ── MAP CLEAN ────────────────────────────────────────────────
local function cleanFolder(parent)
    local list = parent:GetChildren()
    for i=1,#list do
        local o=list[i]
        if o and o.Parent then
            if not keepTree(o) then
                if hasProtectedChild(o) then cleanFolder(o)
                else safeKill(o) end
            end
        end
        if i%50==0 then task.wait() end
    end
end
task.spawn(function()
    for _,name in ipairs({"Map","SeaMap","Environment","World","Map2","Map3","Islands"}) do
        local c = WS:FindFirstChild(name)
        if c then task.spawn(cleanFolder,c) end
    end
end)

